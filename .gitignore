# --- Xcode / iOS -------------------------------------------------------------

# Generated by XcodeGen from project.yml (project.yml is the source of truth)
*.xcodeproj/
*.xcworkspace/

# Generated by XcodeGen from project.yml (info.properties)
ios/Config/TallyCam-Info.plist

# Per-developer settings: Apple team id, bundle id prefix
ios/Config/Local.xcconfig

# Build output and per-user state
build/
DerivedData/
xcuserdata/
*.xcuserstate
*.xcresult
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip
.swiftpm/
.build/

# Signing material: never in the repository (Xcode keeps it in the keychain
# and ~/Library; automatic signing needs none of it here)
*.mobileprovision
*.provisionprofile
*.p12
*.p8
*.cer
*.certSigningRequest

# --- Rust ----------------------------------------------------------------------

target/
*.profraw

# --- Local files ---------------------------------------------------------------

.DS_Store
.env
*.local

# Python bytecode (tools/torch-pair)
__pycache__/

# Android (android/): Gradle output, local SDK path, the core built by scripts/build-core-android.sh
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/jniLibs/
android/.idea/
*.iml

# Android release signing (android/app/build.gradle.kts)
android/keystore.properties
*.jks
*.keystore
