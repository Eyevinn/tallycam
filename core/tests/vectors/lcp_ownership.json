{
 "description": "LCP protocol 2: ownership of exposure, colour and focus, and production settings (docs/SHADING.md). 'messages': each 'json' must parse as the given direction and kind; 'canonical' is what it serializes back to (unknown fields kept only where the type keeps them). 'scenarios': steps on one camera's ownership state machine; after each step 'ownership' is the expected ownership report and 'indicators' what the phone shows. Step results: 'changed' / 'unchanged' or a refusal code (no_such_group, not_remote, remote_owned, still_connected).",
 "messages": [
  {
   "name": "own_two_groups",
   "direction": "server_to_device",
   "json": {"type": "own", "id": 21, "groups": ["exposure", "white_balance"], "holder": {"id": "c7f3a1", "label": "Shader"}, "future": true},
   "canonical": {"type": "own", "id": 21, "groups": ["exposure", "white_balance"], "holder": {"id": "c7f3a1", "label": "Shader"}}
  },
  {
   "name": "release_without_id",
   "direction": "server_to_device",
   "json": {"type": "release", "groups": ["exposure"]},
   "canonical": {"type": "release", "groups": ["exposure"]}
  },
  {
   "name": "production_mains",
   "direction": "server_to_device",
   "json": {"type": "production", "mains_hz": 50, "shutter": "mains"},
   "canonical": {"type": "production", "mains_hz": 50, "shutter": "mains"}
  },
  {
   "name": "production_fixed_shutter_keeps_unknown_fields",
   "direction": "server_to_device",
   "json": {"type": "production", "mains_hz": 60, "shutter": 120, "frame_rate": 60},
   "canonical": {"type": "production", "mains_hz": 60, "shutter": 120, "frame_rate": 60}
  },
  {
   "name": "production_free",
   "direction": "server_to_device",
   "json": {"type": "production", "mains_hz": 0, "shutter": "free"},
   "canonical": {"type": "production", "mains_hz": 0, "shutter": "free"}
  },
  {
   "name": "production_unknown_shutter_reads_as_mains",
   "direction": "server_to_device",
   "json": {"type": "production", "mains_hz": 50, "shutter": "angle_180"},
   "canonical": {"type": "production", "mains_hz": 50, "shutter": "mains"}
  },
  {
   "name": "production_without_shutter_is_mains",
   "direction": "server_to_device",
   "json": {"type": "production", "mains_hz": 50},
   "canonical": {"type": "production", "mains_hz": 50, "shutter": "mains"}
  },
  {
   "name": "ownership_report",
   "direction": "device",
   "json": {"type": "ownership", "groups": {"exposure": {"owner": "remote", "holder": {"id": "c7f3a1", "label": "Shader"}}, "white_balance": {"owner": "local"}, "focus": {"owner": "auto"}}},
   "canonical": {"type": "ownership", "groups": {"exposure": {"owner": "remote", "holder": {"id": "c7f3a1", "label": "Shader"}}, "white_balance": {"owner": "local"}, "focus": {"owner": "auto"}}}
  }
 ],
 "scenarios": [
  {
   "name": "starts_in_auto",
   "groups": ["exposure", "white_balance", "focus"],
   "steps": [
    {"do": "connect",
     "ownership": {"exposure": {"owner": "auto"}, "white_balance": {"owner": "auto"}, "focus": {"owner": "auto"}},
     "indicators": {"exposure": "auto", "white_balance": "auto", "focus": "auto"}}
   ]
  },
  {
   "name": "operator_locks_then_goes_back_to_auto",
   "groups": ["exposure", "white_balance", "focus"],
   "steps": [
    {"do": "connect"},
    {"do": "local_change", "group": "white_balance", "result": "changed",
     "ownership": {"exposure": {"owner": "auto"}, "white_balance": {"owner": "local"}, "focus": {"owner": "auto"}},
     "indicators": {"white_balance": "locked"}},
    {"do": "local_change", "group": "white_balance", "result": "unchanged"},
    {"do": "local_auto", "group": "white_balance", "result": "changed",
     "indicators": {"white_balance": "auto"}}
   ]
  },
  {
   "name": "remote_takes_over_from_local_and_releases_to_auto",
   "groups": ["exposure", "white_balance", "focus"],
   "steps": [
    {"do": "connect"},
    {"do": "local_change", "group": "exposure", "result": "changed"},
    {"do": "own", "groups": ["exposure", "white_balance"], "holder": {"id": "a", "label": "Shader A"},
     "taken": ["exposure", "white_balance"], "from_local": ["exposure"], "skipped": [],
     "ownership": {"exposure": {"owner": "remote", "holder": {"id": "a", "label": "Shader A"}}, "white_balance": {"owner": "remote", "holder": {"id": "a", "label": "Shader A"}}, "focus": {"owner": "auto"}},
     "indicators": {"exposure": "remote", "white_balance": "remote", "focus": "auto"}},
    {"do": "local_change", "group": "exposure", "result": "remote_owned"},
    {"do": "local_auto", "group": "exposure", "result": "remote_owned"},
    {"do": "release", "groups": ["exposure", "focus"], "released": ["exposure"],
     "ownership": {"exposure": {"owner": "auto"}, "white_balance": {"owner": "remote", "holder": {"id": "a", "label": "Shader A"}}, "focus": {"owner": "auto"}}}
   ]
  },
  {
   "name": "remote_set_needs_ownership",
   "groups": ["exposure", "white_balance", "focus"],
   "steps": [
    {"do": "connect"},
    {"do": "remote_set", "group": "exposure", "result": "not_remote"},
    {"do": "own", "groups": ["exposure"], "holder": {"id": "a", "label": "Shader A"}, "taken": ["exposure"]},
    {"do": "remote_set", "group": "exposure", "result": "changed"},
    {"do": "remote_set", "group": "white_balance", "result": "not_remote"}
   ]
  },
  {
   "name": "own_skips_groups_the_camera_lacks",
   "groups": ["exposure", "white_balance"],
   "steps": [
    {"do": "connect"},
    {"do": "own", "groups": ["focus", "exposure", "iris"], "holder": {"id": "a", "label": "Shader A"},
     "taken": ["exposure"], "from_local": [], "skipped": ["focus", "iris"],
     "ownership": {"exposure": {"owner": "remote", "holder": {"id": "a", "label": "Shader A"}}, "white_balance": {"owner": "auto"}}},
    {"do": "remote_set", "group": "focus", "result": "no_such_group"}
   ]
  },
  {
   "name": "second_holder_takes_over_explicitly",
   "groups": ["exposure", "white_balance", "focus"],
   "steps": [
    {"do": "connect"},
    {"do": "own", "groups": ["exposure"], "holder": {"id": "auto-shader", "label": "Auto shader"}, "taken": ["exposure"]},
    {"do": "own", "groups": ["exposure"], "holder": {"id": "auto-shader", "label": "Auto shader"}, "taken": [], "from_local": []},
    {"do": "own", "groups": ["exposure"], "holder": {"id": "b", "label": "Shader B"}, "taken": ["exposure"], "from_local": [],
     "ownership": {"exposure": {"owner": "remote", "holder": {"id": "b", "label": "Shader B"}}, "white_balance": {"owner": "auto"}, "focus": {"owner": "auto"}}}
   ]
  },
  {
   "name": "link_lost_keeps_remote_values",
   "groups": ["exposure", "white_balance", "focus"],
   "steps": [
    {"do": "connect"},
    {"do": "own", "groups": ["exposure"], "holder": {"id": "a", "label": "Shader A"}, "taken": ["exposure"]},
    {"do": "disconnect",
     "ownership": {"exposure": {"owner": "remote", "holder": {"id": "a", "label": "Shader A"}}, "white_balance": {"owner": "auto"}, "focus": {"owner": "auto"}},
     "indicators": {"exposure": "remote_disconnected", "white_balance": "auto"}},
    {"do": "local_change", "group": "exposure", "result": "remote_owned"},
    {"do": "connect",
     "indicators": {"exposure": "remote"}}
   ]
  },
  {
   "name": "escape_hatch_only_while_disconnected",
   "groups": ["exposure", "white_balance", "focus"],
   "steps": [
    {"do": "connect"},
    {"do": "own", "groups": ["focus"], "holder": {"id": "a", "label": "Shader A"}, "taken": ["focus"]},
    {"do": "take_local", "group": "focus", "result": "still_connected"},
    {"do": "disconnect"},
    {"do": "take_local", "group": "focus", "result": "changed",
     "ownership": {"exposure": {"owner": "auto"}, "white_balance": {"owner": "auto"}, "focus": {"owner": "local"}},
     "indicators": {"focus": "locked"}},
    {"do": "connect",
     "indicators": {"focus": "locked"}}
   ]
  },
  {
   "name": "restart_restores_remote_disconnected",
   "groups": ["exposure", "white_balance", "focus"],
   "steps": [
    {"do": "connect"},
    {"do": "own", "groups": ["exposure", "white_balance"], "holder": {"id": "a", "label": "Shader A"}, "taken": ["exposure", "white_balance"]},
    {"do": "local_change", "group": "focus", "result": "changed"},
    {"do": "restart",
     "ownership": {"exposure": {"owner": "remote", "holder": {"id": "a", "label": "Shader A"}}, "white_balance": {"owner": "remote", "holder": {"id": "a", "label": "Shader A"}}, "focus": {"owner": "local"}},
     "indicators": {"exposure": "remote_disconnected", "white_balance": "remote_disconnected", "focus": "locked"}}
   ]
  },
  {
   "name": "new_server_releases_remote_groups",
   "groups": ["exposure", "white_balance", "focus"],
   "steps": [
    {"do": "connect"},
    {"do": "own", "groups": ["exposure", "focus"], "holder": {"id": "a", "label": "Shader A"}, "taken": ["exposure", "focus"]},
    {"do": "local_change", "group": "white_balance", "result": "changed"},
    {"do": "disconnect"},
    {"do": "new_server", "released": ["exposure", "focus"],
     "ownership": {"exposure": {"owner": "auto"}, "white_balance": {"owner": "local"}, "focus": {"owner": "auto"}}}
   ]
  }
 ]
}
