// Shared build settings. Per-developer values (team, bundle id prefix) live in
// Local.xcconfig, which is not committed. Copy Local.template.xcconfig to start.
BUNDLE_ID_PREFIX = se.eyevinn
CODE_SIGN_STYLE = Automatic

// The app version (CFBundleShortVersionString) and build number
// (CFBundleVersion). scripts/testflight.sh overrides the build number with
// the commit count, so each upload is higher than the last.
MARKETING_VERSION = 0.2.0
CURRENT_PROJECT_VERSION = 1

#include? "Local.xcconfig"
